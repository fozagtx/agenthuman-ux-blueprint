# Public URL of this server. Claude must be able to reach it (use a tunnel like
# `cloudflared tunnel --url http://localhost:4000` when testing locally).
PUBLIC_API_URL=http://localhost:4000
PORT=4000

DATABASE_URL=postgres://mcp:mcp@127.0.0.1:5434/mcp

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Enables the built-in email-only /login page. Only for local development —
# turn it off and plug in your product's real login (see docs/ADAPTING.md).
DEV_LOGIN=true

# Branding (optional). Defaults live in src/project/branding.ts.
# BRAND_NAME=AgentHuman UX
# BRAND_FAVICON_PATH=/absolute/path/to/favicon.svg   # .svg, .png or .ico
# BRAND_ACCENT_COLOR=#4054d6
